# Copy to .env.local (gitignored) and fill in. Mirror the same values into
# Vercel -> Settings -> Environment Variables.

# --- Firebase web config (safe to expose; inlined into the browser bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin service account (SECRET - full project access) ---
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the whole key on one line, keeping the literal \n escapes, in quotes:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Bunny Storage (password is SECRET - never prefix with NEXT_PUBLIC_) ---
BUNNY_STORAGE_ZONE=thepremiumconstruction
BUNNY_STORAGE_PASSWORD=
BUNNY_S3_ENDPOINT=https://de-s3.storage.bunnycdn.com
# Hostname of the Pull Zone linked to the storage zone, no protocol:
NEXT_PUBLIC_BUNNY_CDN_HOST=
