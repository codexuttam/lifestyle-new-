# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# DO NOT ADD REAL SECRETS OR PASSWORDS TO THIS FILE!
# Copy this file to .env.local (which is gitignored) and fill in your real credentials:
#   cp .env.example .env.local
#
# Mirror these variables in your deployment dashboard (e.g. Vercel -> Settings -> Environment Variables).
# ==============================================================================

# --- WhatsApp Business Cloud API Configuration ---
VITE_WHATSAPP_PHONE_ID="your_whatsapp_phone_id"
VITE_WHATSAPP_APP_ID="your_whatsapp_app_id"
VITE_WHATSAPP_WABA_ID="your_whatsapp_waba_id"
VITE_WHATSAPP_ACCESS_TOKEN="your_whatsapp_system_user_access_token"
NEXT_PUBLIC_WHATSAPP_ACCESS_TOKEN="your_whatsapp_system_user_access_token"

# --- Real Estate CRM Configuration ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
VITE_CRM_ORG_ID="your_crm_organization_id"
VITE_CRM_ADMIN_ID="your_crm_admin_id"
VITE_CRM_ADMIN_EMAIL="admin@example.com"
VITE_CRM_AGENT_ID="your_crm_agent_id"
VITE_CRM_AGENT_EMAIL="agent@example.com"
VITE_CRM_WEBHOOK_URL="https://your-crm-domain.com/api/webhooks/leads"
VITE_CRM_WEBHOOK_SECRET="your_crm_webhook_secret"
VITE_OWNER_WHATSAPP_NUMBER="919999999999"
VITE_LIFESTYLE_WHATSAPP_NUMBER="919999999999"
NEXT_PUBLIC_LIFESTYLE_WHATSAPP_NUMBER="919999999999"

# --- Bitlance AI Notification Service (Alerts to Owner) ---
VITE_BITLANCE_WHATSAPP_PHONE_ID="your_bitlance_phone_id"
VITE_BITLANCE_WHATSAPP_TOKEN="your_bitlance_whatsapp_token"

# --- Bitlance Social & SEO AI Blog Generator API ---
VITE_BITLANCE_BLOG_API_KEY="your_bitlance_blog_api_key"
VITE_BITLANCE_BLOG_API_BASE_URL="https://api.bitlancetechhub.com"

# --- Admin Portal Passcode ---
VITE_ADMIN_PASSCODE="your_admin_passcode"
NEXT_PUBLIC_ADMIN_PASSCODE="your_admin_passcode"

# --- Public aliases for Next.js ---
NEXT_PUBLIC_WHATSAPP_PHONE_ID="your_whatsapp_phone_id"
NEXT_PUBLIC_WHATSAPP_APP_ID="your_whatsapp_app_id"
NEXT_PUBLIC_WHATSAPP_WABA_ID="your_whatsapp_waba_id"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_OWNER_WHATSAPP_NUMBER="919999999999"

# --- Firebase Web Config (Safe to expose; inlined into browser bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin Service Account (SECRET - server-side only) ---
FIREBASE_ADMIN_CLIENT_EMAIL=""
# Paste private key on one line with literal \n escapes:
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- Bunny Storage (SECRET - never prefix with NEXT_PUBLIC_) ---
BUNNY_STORAGE_ZONE="your_storage_zone"
BUNNY_STORAGE_PASSWORD="your_bunny_storage_password"
BUNNY_S3_ENDPOINT="https://de-s3.storage.bunnycdn.com"
NEXT_PUBLIC_BUNNY_CDN_HOST="your-pullzone.b-cdn.net"
