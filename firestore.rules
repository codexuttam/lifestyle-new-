rules_version = '2';

// All content access goes through Next.js route handlers using the Firebase
// Admin SDK, which bypasses these rules. Nothing should ever reach Firestore
// from a browser, so everything is denied here: the public web API key is
// therefore worthless to an attacker.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
